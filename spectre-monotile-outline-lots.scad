// Produce Tile(a,b)
a = 1;
b = 1;

curve_amount = 0.1;

c = cos(60);
s = sin(60);

moves = [
    [0,0],
    [c*b, s*b],
    [b,0],
    [0,a],
    [s*a, c*a],
    [c*b, -s*b],
    [-c*b, -s*b],
    [s*a, -c*a],
    [0, -a],
    [0, -a],
    [-s*a, -c*a],
    [-c*b, s*b],
    [-b, 0],
    [0, a],
    [-s*a, c*a]
];
   
  /* 
points = [ 
    for (
        i=0, p=moves[0]; 
        i < len(moves)-1; 
        i = i+1, p = p + moves[i]
    )
    p
];
*/

points = [
    [0, 0],
    [1.0, 0.0],
    [1.5, -0.8660254037844386],
    [2.366025403784439, -0.36602540378443865],
    [2.366025403784439, 0.6339745962155614],
    [3.366025403784439, 0.6339745962155614],
    [3.866025403784439, 1.5],
    [3.0, 2.0],
    [2.133974596215561, 1.5],
    [1.6339745962155614, 2.3660254037844393],
    [0.6339745962155614, 2.3660254037844393],
    [-0.3660254037844386, 2.3660254037844393],
    [-0.866025403784439, 1.5],
    [0.0, 1.0] 
]
;
    
function curve_between(a, b, steps=20, curve=curve_amount) = 
    let(
        d = b-a,
        n = [d[1],-d[0]]/norm(d)
    )
    [ for (i=0,t=0; i<steps; i = i+1, t=i/steps) t*b + (1-t)*a + n*sin(-360*t)*curve ]
;

curve_points = [ for(i=0;i<len(points);i=i+1) each curve_between(points[i], points[(i+1) % len(points)]) ];

off = [-2,-1.5,0];
 module tile(height) {
     translate(-off)
     linear_extrude(height,scale=0.9) {
         translate(off)
         difference() {
             offset(-0.05) polygon(curve_points);
             offset(-0.15) polygon(curve_points);
         }
     }
 }
 
